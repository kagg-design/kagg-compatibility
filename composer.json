{
  "name": "kagg/compatibility",
  "description": "KAGG Compatibility",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "compatibility",
    "PHP 8",
    "development",
    "deprecation",
    "notice"
  ],
  "homepage": "https://wordpress.org/plugins/kagg-compatibility/",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "KAGG Design",
      "email": "info@kagg.eu",
      "homepage": "https://kagg.eu/en/"
    }
  ],
  "support": {
    "issues": "https://wordpress.org/support/plugin/kagg-compatibility"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13.6",
    "phpcompatibility/php-compatibility": "^9.3.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload": {
    "psr-4": {
      "KAGG\\Compatibility\\": "src/php",
      "KAGG\\Compatibility\\Settings\\Abstracts\\": "src/php/Settings/Abstracts"
    },
    "exclude-from-classmap": [
      "src/php/kagg-compatibility-error-handler.php"
    ]
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs --colors --standard=phpcs.xml",
    "test": [
      "@php tests/run.php",
      "@php tests/run.php --disabled"
    ],
    "changelog": "@php .github/scripts/update-changelog.php",
    "changelog:check": "@php .github/scripts/update-changelog.php --check",
    "prepare": "git config core.hooksPath .githooks"
  },
  "require": {
    "php": ">=7.4"
  }
}
